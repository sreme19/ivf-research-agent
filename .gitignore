studies/*/data/
!studies/*/data/.gitkeep
!studies/*/data/README.md

# Any file that looks like an extract, anywhere
*.xlsx
*.xls
*.csv
*.tsv
*.sav
*.dta
*.rds
*.RData
*.parquet
*.db
*.sqlite

# Linkage / re-identification files — must live OUTSIDE this repo entirely
*linkage*
*identifiers*
*mrn*
*_phi*

# ─────────────────────────────────────────────────────────────
